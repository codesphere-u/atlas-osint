# ---------------------------------------------------------------------------
# ATLAS OSINT configuration. NEVER commit .env.
# Recommended: ./deploy/setup.sh --domain atlas.example.org --admin-email you@example.org
# writes .env from this template with every secret generated. Manual alternative: copy this file to .env and
# generate keys with  docker compose run --rm --no-deps api atlas generate-keys
# ---------------------------------------------------------------------------

# Public hostname served by Caddy (use "localhost" for local testing)
ATLAS_DOMAIN=localhost
ATLAS_ENV=production

# --- required secrets ---
ATLAS_SECRET_KEY=
ATLAS_ENCRYPTION_KEY=
ATLAS_HASH_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# First administrator (created on first start if it does not exist; password min. 12 chars)
ATLAS_BOOTSTRAP_ADMIN_EMAIL=
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=

# --- compliance ---
ATLAS_DEFAULT_RETENTION_DAYS=90
ATLAS_MAX_RETENTION_DAYS=365

# --- AI analyst (optional): none | anthropic | openai_compatible ---
ATLAS_AI_PROVIDER=none
ATLAS_AI_MODEL=claude-opus-5-5
ATLAS_ANTHROPIC_API_KEY=
ATLAS_OPENAI_COMPATIBLE_BASE_URL=

# --- optional source credentials (sources report "not configured" without them) ---
ATLAS_GITHUB_TOKEN=
ATLAS_HIBP_API_KEY=
ATLAS_COMPANIES_HOUSE_API_KEY=
ATLAS_OPENCORPORATES_API_TOKEN=
ATLAS_NUMVERIFY_API_KEY=
# SEC fair-access policy: "Organisation contact@example.org"
ATLAS_SEC_EDGAR_USER_AGENT=
ATLAS_OPENSANCTIONS_API_KEY=
# Optional SSLMate key for Cert Spotter (higher limits)
ATLAS_CERTSPOTTER_API_KEY=

# --- v0.2 ---
# DNS backend: "system" or "doh" (DNS-over-HTTPS; use where outbound port 53 is filtered)
ATLAS_DNS_RESOLVER=system
ATLAS_DOH_URL=https://dns.google/resolve
# Mastodon instances queried for handles (comma-separated)
ATLAS_FEDIVERSE_INSTANCES=mastodon.social

# --- operations ---
# Restrict the application to these networks (space-separated CIDRs, quoted). Empty = reachable from anywhere.
# The public privacy-request page stays reachable for data subjects. Recommended until MFA is available.
# ATLAS_ALLOWED_IPS="203.0.113.0/24 198.51.100.7/32"
# Published release images instead of building on the server (see docs/deployment.md):
# ATLAS_IMAGE_REPO=ghcr.io/codesphere-u/atlas-osint
# ATLAS_VERSION=v0.2.0
# Scheduled database backups (pg_dump) – copy the directory off the server regularly
ATLAS_BACKUP_DIR=./backups
ATLAS_BACKUP_INTERVAL_HOURS=24
ATLAS_BACKUP_KEEP_DAYS=14
# Host ports (change only if 80/443 are taken; ACME certificates need 80/443 reachable from the internet)
# ATLAS_HTTP_PORT=80
# ATLAS_HTTPS_PORT=443
# Memory limits per container (defaults suit a 4 GB server)
# ATLAS_MEM_API=1g
# ATLAS_MEM_WORKER=1536m
# ATLAS_MEM_POSTGRES=1g
# ATLAS_MEM_WEB=512m
